# Copy this file to .env and fill in your values. Never commit the real .env.

# --- LLM provider ---
# One of: gemini | openai | anthropic  (see backend/services/llm_service.py)
LLM_PROVIDER=gemini

# Gemini (recommended free option -- get a key at https://aistudio.google.com/apikey,
# no credit card required for the free tier as of this writing). Free-tier model:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Chatterbox (voice cloning / TTS) ---
CHATTERBOX_DEVICE=auto
CHATTERBOX_T3_MODEL=v3
CHATTERBOX_LANGUAGE=fr
CHATTERBOX_EXAGGERATION=0.5
CHATTERBOX_CFG_WEIGHT=0.5

# --- Active teacher voice (folder name under voices/) ---
ACTIVE_TEACHER_VOICE=teacher_1

# --- Speech-to-text (faster-whisper) ---
# CPU by default to leave the GPU free for Chatterbox; set to "cuda" if you have
# VRAM headroom to spare.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Session defaults ---
DEFAULT_STUDENT_LEVEL=beginner

# --- Video references (see backend/services/video_library.py) ---
# Populates a local video catalog from YouTube's official Data API v3 (NOT
# scraped -- see scripts/fetch_youtube_channel.py for why), so the teacher can
# occasionally reference a real video for a topic that came up. Get a free key:
# Google Cloud Console -> APIs & Services -> Library -> enable "YouTube Data
# API v3" -> Credentials -> Create API key.
YOUTUBE_API_KEY=
DREAMING_YOUTUBE_CHANNEL_ID=UCG7lancLEOKXZ7lEEyzvwjA

# --- Access control (see main.py basic_auth_gate) ---
# Leave both blank for local dev (no login prompt). REQUIRED before hosting
# this publicly -- without it, anyone with the URL can run Chatterbox/LLM
# calls on your bill. Pick a real password, not the placeholder below.
APP_USERNAME=team
APP_PASSWORD=
